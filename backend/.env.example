# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.

# MySQL 8+ connection (database name: findback)
DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost:3306/findback

# JWT signing secret - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-secure-secret

# Token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Algorithm
ALGORITHM=HS256

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini API key (optional - AI features degrade gracefully without it)
GEMINI_API_KEY=

# AI configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
MATCH_TOP_K=10

# Scoring weights (must roughly sum to 1.0)
W_TEXT=0.50
W_IMAGE=0.30
W_LOCATION=0.15
W_CATEGORY=0.05

# Uploads
MEDIA_DIR=
MAX_UPLOAD_SIZE_MB=5

DEBUG=true
